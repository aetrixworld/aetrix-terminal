# Copy to `.env` and fill in real values to override the defaults in src/config.ts.

# Platform fee in basis points (50 = 0.50%). Jupiter caps platform fees at 255 bps.
VITE_PLATFORM_FEE_BPS=50

# Jupiter referral account (created at https://referral.jup.ag) that owns the
# fee token accounts. src/config.ts already defaults to the live referral
# account, so this override is only needed to point at a different account.
# The per-mint fee token accounts are derived from this address in code.
# VITE_REFERRAL_ACCOUNT=6VJdba2jVgKrpcZXwXMEUcYqzU2uwD3h2sFqw6BTxyJ5

# Optional: dedicated Solana RPC endpoint (recommended for production).
# VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Module 2 (Launchpad): platform owner's wallet that receives the flat
# token-creation fee, and the fee amount in SOL. src/config.ts already
# defaults to the live platform wallet and 0.05 SOL.
# VITE_PLATFORM_WALLET=EEreSuo5dibxdc8uWG5hVwwckTnzUyRBLGkUbWt42JZi
# VITE_LAUNCH_FEE_SOL=0.05
